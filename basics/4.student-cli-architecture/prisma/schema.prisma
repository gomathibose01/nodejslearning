datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider    = "prisma-client-js"
  engineType  = "client"
}

model Student {
  id        Int      @id @default(autoincrement())
  // @id         = PRIMARY KEY
  // @default(autoincrement()) = DB2's GENERATED ALWAYS AS IDENTITY

  name      String
  // String in Prisma = TEXT column in SQLite = VARCHAR in DB2

  grade     Int
  // grade level 1-12

  subject   String
  // one of: Maths, Science, English, History, Geography

  status    String   @default("ACTIVE")
  // ACTIVE | DELETED
  // We never physically delete rows — same practice as mainframe audit tables

  createdAt DateTime @default(now())
  // @default(now()) = CURRENT TIMESTAMP in DB2

  updatedAt DateTime @updatedAt
  // Prisma automatically updates this on every UPDATE — like a DB2 trigger
}

